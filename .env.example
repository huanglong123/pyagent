# LangSmith tracing
# Docs: https://docs.smith.langchain.com/
#
# Cloud SaaS (default): set LANGSMITH_TRACING=true and LANGSMITH_API_KEY.
# Get your API key from https://smith.langchain.com/settings
#
# Self-hosted / local Docker: run the LangSmith stack locally
# (https://github.com/langchain-ai/langsmith-sdk/blob/main/docker/README.md)
# and point LANGSMITH_ENDPOINT at it (typically http://localhost:1984).
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=pyagent

# LLM Provider API Keys (at least one required)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=

# Default model configuration
PYAGENT_MODEL_PROVIDER=deepseek
PYAGENT_MODEL_NAME=deepseek-v4-flash
PYAGENT_MODEL_TEMPERATURE=0.7

# Server (for RPC mode)
PYAGENT_SERVER_HOST=127.0.0.1
PYAGENT_SERVER_PORT=8765

# Storage
PYAGENT_DB_PATH=.pyagent/sessions.db

# Error logging
PYAGENT_ERROR_LOG_PATH=.pyagent/error.log
PYAGENT_ERROR_LOG_LEVEL=ERROR
